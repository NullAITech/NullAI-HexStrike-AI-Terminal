[Desktop Entry]
Version=1.0
Type=Application
Name=NullAI HexStrike
GenericName=Offensive Security & Red-Team Terminal
Comment=Local-first security tool catalog, socket scanner, and MCP workstation
Exec=/usr/local/bin/hexstrike desktop
Icon=hexstrike
Terminal=false
Categories=Security;Development;System;Network;
StartupNotify=true
Actions=Terminal;Web;

[Desktop Action Terminal]
Name=Open HexStrike CLI
Exec=x-terminal-emulator -e "/usr/local/bin/hexstrike --help"

[Desktop Action Web]
Name=Open in Browser (Port 8138)
Exec=/usr/local/bin/hexstrike web
