      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b0\u28f6\u28f6\u28f6\u28f6\u28f6\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b9\u28ff\u284f\u2809\u28ff\u28ff\u2801\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u2807\u2800\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b9\u28ff\u284f\u2809\u28ff\u28ff\u2801\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u2807\u2800\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u28c0\u28c0\u28c0\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28a0\u28e4\u28e4\u28e4\u28e4\u28e4\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2801\u2800\u2809\u2809\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28a0\u28e4\u28e4\u28e4\u28e4\u28e4\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u2846\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28bb\u28ff\u285f\u281b\u28ff\u28ff\u2803\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28a0\u28e4\u28e4\u28e4\u28e4\u28e4\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2801\u2800\u2809\u2809\u2800\u2800\u2800\u2800\u2800"
    ],
    "ability": [
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28e0\u28e4\u28d2\u28d2\u28e2\u28e4\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u28e0\u280a\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2808\u28a2\u2840\u2800\u2800\n\u2800\u2800\u28a0\u2803\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u28a3\u2800\u2800\n\u2800\u2800\u2838\u2840\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2878\u2800\u2800\n\u2800\u2800\u2800\u2833\u2840\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2870\u2803\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u28ba\u28ff\u28c7\u28c0\u28ff\u28ff\u280a\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u28c0\u2814\u2812\u2809\u2809\u2811\u2812\u2884\u2840\u2800\u2800\u2800\n\u2800\u2800\u2880\u281c\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2818\u2884\u2800\u2800\n\u2800\u2800\u285c\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2818\u2844\u2800\n\u2800\u2800\u2887\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2880\u2807\u2800\n\u2800\u2800\u2818\u2884\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2880\u281c\u2800\u2800\n\u2800\u2800\u2800\u2808\u2812\u28bd\u28ff\u284f\u2809\u28ff\u28ff\u2815\u280a\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u280f\u2809\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28c0\u28c0\u2840\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2880\u2814\u280a\u2809\u2800\u2800\u2808\u2809\u2812\u2884\u2800\u2800\u2800\n\u2800\u2800\u2870\u2801\u2800\u28b0\u28f6\u28f6\u28f6\u28f6\u28f6\u2800\u2800\u2831\u2840\u2800\n\u2800\u28a0\u2803\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u28a3\u2800\n\u2800\u2838\u2840\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2878\u2800\n\u2800\u2800\u28a3\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u28a0\u2803\u2800\n\u2800\u2800\u2800\u2811\u2884\u28f9\u28ff\u284f\u2809\u28ff\u28ff\u28c1\u2814\u2801\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u2817\u2812\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u2824\u2824\u2884\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2864\u280a\u2801\u2800\u2800\u2800\u2800\u2800\u2809\u2822\u2844\u2800\u2800\n\u2800\u2880\u280e\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2808\u2886\u2800\n\u2800\u285c\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2818\u2844\n\u2800\u2887\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2880\u2807\n\u2800\u2818\u2844\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u285c\u2800\n\u2800\u2800\u2808\u2826\u2840\u28b9\u28ff\u284f\u2809\u28ff\u28ff\u2801\u2860\u280e\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u2839\u283f\u2827\u2824\u283f\u283f\u2809\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28e0\u28e4\u28d2\u28d2\u28e2\u28e4\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u28e0\u280a\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2808\u28a2\u2840\u2800\u2800\n\u2800\u2800\u28a0\u2803\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u28a3\u2800\u2800\n\u2800\u2800\u2838\u2840\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2878\u2800\u2800\n\u2800\u2800\u2800\u2833\u2840\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2870\u2803\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u28ba\u28ff\u28c7\u28c0\u28ff\u28ff\u280a\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u28c0\u28b4\u28f6\u28ed\u28ed\u28f5\u28f6\u2884\u2840\u2800\u2800\u2800\n\u2800\u2800\u2880\u281c\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2818\u2884\u2800\u2800\n\u2800\u2800\u285c\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2818\u2844\u2800\n\u2800\u2800\u2887\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2880\u2807\u2800\n\u2800\u2800\u2818\u2884\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2880\u281c\u2800\u2800\n\u2800\u2800\u2800\u2808\u2812\u28bc\u28ff\u2847\u2800\u28ff\u28ff\u2814\u280a\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2809\u2809\u2809\u2809\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28c0\u28c0\u2840\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2880\u2814\u28aa\u28ed\u28e4\u28e4\u28ec\u28ed\u2812\u2884\u2800\u2800\u2800\n\u2800\u2800\u2870\u2801\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2831\u2840\u2800\n\u2800\u28a0\u2803\u2800\u2800\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u2846\u2800\u2800\u28a3\u2800\n\u2800\u2838\u2840\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2878\u2800\n\u2800\u2800\u28a3\u2800\u2800\u28bb\u28ff\u285f\u281b\u28ff\u28ff\u2803\u2800\u28a0\u2803\u2800\n\u2800\u2800\u2800\u2811\u2884\u28f8\u28ff\u2847\u2800\u28ff\u28ff\u28c0\u2814\u2801\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2812\u2812\u280a\u2809\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u2824\u2824\u2884\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2864\u280a\u28a1\u28e4\u28e4\u28e4\u28e4\u28e4\u2809\u2822\u2844\u2800\u2800\n\u2800\u2880\u280e\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2808\u2886\u2800\n\u2800\u285c\u2800\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2800\u2818\u2844\n\u2800\u2887\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2880\u2807\n\u2800\u2818\u2844\u2800\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2800\u2800\u285c\u2800\n\u2800\u2800\u2808\u2826\u2840\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2860\u280e\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u2819\u281b\u2825\u2824\u281d\u281b\u2809\u2800\u2800\u2800\u2800"
    ],
    "ultimate": [
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28e0\u28e4\u28d2\u28d2\u28e2\u28e4\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u28e0\u280a\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2808\u28a2\u2840\u2800\u2800\n\u2800\u2800\u28a0\u2803\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u28a3\u2800\u2800\n\u2800\u2800\u2838\u2840\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2878\u2800\u2800\n\u2800\u2800\u2800\u2833\u2840\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2870\u2803\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u28ba\u28ff\u28c7\u28c0\u28ff\u28ff\u280a\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u28c0\u2814\u2812\u2809\u2809\u2811\u2812\u2884\u2840\u2800\u2800\u2800\n\u2800\u2800\u2880\u281c\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2818\u2884\u2800\u2800\n\u2800\u2800\u285c\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2818\u2844\u2800\n\u2800\u2800\u2887\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2880\u2807\u2800\n\u2800\u2800\u2818\u2884\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2880\u281c\u2800\u2800\n\u2800\u2800\u2800\u2808\u2812\u28bd\u28ff\u284f\u2809\u28ff\u28ff\u2815\u280a\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u280f\u2809\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28c0\u28c0\u2840\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2880\u2814\u280a\u2809\u2800\u2800\u2808\u2809\u2812\u2884\u2800\u2800\u2800\n\u2800\u2800\u2870\u2801\u2800\u28b0\u28f6\u28f6\u28f6\u28f6\u28f6\u2800\u2800\u2831\u2840\u2800\n\u2800\u28a0\u2803\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u28a3\u2800\n\u2800\u2838\u2840\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2878\u2800\n\u2800\u2800\u28a3\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u28a0\u2803\u2800\n\u2800\u2800\u2800\u2811\u2884\u28f9\u28ff\u284f\u2809\u28ff\u28ff\u28c1\u2814\u2801\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u2817\u2812\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u2824\u2824\u2884\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2864\u280a\u2801\u2800\u2800\u2800\u2800\u2800\u2809\u2822\u2844\u2800\u2800\n\u2800\u2880\u280e\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2808\u2886\u2800\n\u2800\u285c\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2818\u2844\n\u2800\u2887\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2880\u2807\n\u2800\u2818\u2844\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u285c\u2800\n\u2800\u2800\u2808\u2826\u2840\u28b9\u28ff\u284f\u2809\u28ff\u28ff\u2801\u2860\u280e\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u2839\u283f\u2827\u2824\u283f\u283f\u2809\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28e0\u28e4\u28d2\u28d2\u28e2\u28e4\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u28e0\u280a\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2808\u28a2\u2840\u2800\u2800\n\u2800\u2800\u28a0\u2803\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u28a3\u2800\u2800\n\u2800\u2800\u2838\u2840\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2878\u2800\u2800\n\u2800\u2800\u2800\u2833\u2840\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2870\u2803\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u28ba\u28ff\u28c7\u28c0\u28ff\u28ff\u280a\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u28c0\u28b4\u28f6\u28ed\u28ed\u28f5\u28f6\u2884\u2840\u2800\u2800\u2800\n\u2800\u2800\u2880\u281c\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2818\u2884\u2800\u2800\n\u2800\u2800\u285c\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2818\u2844\u2800\n\u2800\u2800\u2887\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2880\u2807\u2800\n\u2800\u2800\u2818\u2884\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2880\u281c\u2800\u2800\n\u2800\u2800\u2800\u2808\u2812\u28bc\u28ff\u2847\u2800\u28ff\u28ff\u2814\u280a\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2809\u2809\u2809\u2809\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28c0\u28c0\u2840\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2880\u2814\u28aa\u28ed\u28e4\u28e4\u28ec\u28ed\u2812\u2884\u2800\u2800\u2800\n\u2800\u2800\u2870\u2801\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2831\u2840\u2800\n\u2800\u28a0\u2803\u2800\u2800\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u2846\u2800\u2800\u28a3\u2800\n\u2800\u2838\u2840\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2878\u2800\n\u2800\u2800\u28a3\u2800\u2800\u28bb\u28ff\u285f\u281b\u28ff\u28ff\u2803\u2800\u28a0\u2803\u2800\n\u2800\u2800\u2800\u2811\u2884\u28f8\u28ff\u2847\u2800\u28ff\u28ff\u28c0\u2814\u2801\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2808\u2809\u2812\u2812\u280a\u2809\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u2824\u2824\u2884\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2864\u280a\u28a1\u28e4\u28e4\u28e4\u28e4\u28e4\u2809\u2822\u2844\u2800\u2800\n\u2800\u2880\u280e\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2808\u2886\u2800\n\u2800\u285c\u2800\u2800\u2800\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u2800\u2800\u2818\u2844\n\u2800\u2887\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2880\u2807\n\u2800\u2818\u2844\u2800\u2800\u28bf\u28ff\u287f\u283f\u28ff\u28ff\u2807\u2800\u2800\u285c\u2800\n\u2800\u2800\u2808\u2826\u2840\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2860\u280e\u2800\u2800\n\u2800\u2800\u2800\u2800\u2808\u2819\u281b\u2825\u2824\u281d\u281b\u2809\u2800\u2800\u2800\u2800"
    ],
    "meditate": [
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2880\u28c0\u28c0\u28c0\u28c0\u28c0\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u2847\u2800\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2818\u281b\u2803\u2800\u281b\u281b\u2800\u2800\u2800\u2800\u2800",
      "\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u2800\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u28b9\u28ff\u284f\u2809\u28ff\u28ff\u2801\u2800\u2800\u2800\u2800\n\u2800\u2800\u2800\u2800\u2800\u2838\u283f\u2807\u2800\u283f\u283f\u2800\u2800\u2800\u2800\u2800",
